{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "WorldOfWarcraft.Front": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation-v4:build",
          "options": {
            "cacheExternalArtifacts": true
          },
          "configurations": {
            "production": {
              "target": "WorldOfWarcraft.Front:esbuild:production"
            },
            "development": {
              "target": "WorldOfWarcraft.Front:esbuild:development",
              "dev": true
            },
            "api": {
              "target": "WorldOfWarcraft.Front:esbuild:api",
              "dev": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation-v4:build",
          "options": {
            "target": "WorldOfWarcraft.Front:serve-original:development",
            "rebuildDelay": 500,
            "cacheExternalArtifacts": true,
            "dev": true,
            "devServer": true,
            "port": 0
          },
          "configurations": {
            "api": {
              "target": "WorldOfWarcraft.Front:serve-original:api",
              "dev": true,
              "devServer": true
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "WorldOfWarcraft.Front:esbuild"
          }
        },
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "localize": true,
            "i18nMissingTranslation": "warning",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@nebular/theme/styles/prebuilt/cosmic.css",
              "node_modules/@bari77/gc-theme/src/global.scss",
              "src/styles.scss"
            ],
            "polyfills": ["zone.js", "@angular/localize/init", "es-module-shims"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "api": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.api.ts"
                }
              ]
            },
            "fr": {
              "localize": ["fr"]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "WorldOfWarcraft.Front:esbuild:production"
            },
            "development": {
              "buildTarget": "WorldOfWarcraft.Front:esbuild:development"
            },
            "api": {
              "buildTarget": "WorldOfWarcraft.Front:esbuild:api"
            },
            "fr": {
              "buildTarget": "WorldOfWarcraft.Front:esbuild:development,fr"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4201,
            "prebundle": {
              "exclude": [
                "@bari77/gc-playground",
                "@bari77/gc-sdk",
                "@bari77/gc-msw"
              ]
            }
          }
        }
      },
      "i18n": {
        "sourceLocale": "en-US",
        "locales": {
          "fr": {
            "translation": "src/locale/source.fr.json"
          }
        }
      }
    }
  }
}
